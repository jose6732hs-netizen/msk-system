+  const reconcileTaskAfterTransport = async (projectId, taskId, executionCard) => {
+    if (!projectId || !taskId) return null;
+    const terminal = new Set(['completed', 'failed', 'awaiting_approval', 'awaiting_input', 'cancelled']);
+    for (let attempt = 0; attempt < 24; attempt++) {
+      const result = await send({
+        type: 'MSK_DIRECT_AGENT_TASK_STATUS_V2',
+        payload: { lovable_project_id: projectId, task_id: taskId }
+      }).catch(() => null);
+
+      const task = result?.task || null;
+      const status = String(task?.status || '').toLowerCase();
+      if (task && status) {
+        if (!terminal.has(status)) {
+          executionCard?.setStage?.(status, attempt === 0
+            ? '🔄 A resposta final se perdeu, mas a tarefa continua no servidor. Confirmando o resultado...'
+            : '');
+        }
+
+        if (status === 'completed') {
+          const summary = String(task?.summary || 'Alteração concluída e confirmada pelo agente.').trim();
+          const shortCommit = summary.match(/\bCommit:\s*([0-9a-f]{7,40})\b/i)?.[1] || '';
+          return {
+            ok: true,
+            completed: true,
+            direct_commit: true,
+            recovered_from_task_status: true,
+            task_status_verified: true,
+            execution_verified: true,
+            commit_verified: true,
+            commit_sha: shortCommit,
+            task_id: taskId,
+            repository: result?.repository || currentRepository || '',
+            branch: task?.branch_name || '',
+            summary,
+            assistant_message: summary,
+            validation: { content_changed: true, semantic: true, commit_verified: true, recovered: true }
+          };
+        }
+
+        if (status === 'failed') {
+          return {
+            ok: false,
+            ...task,
+            code: task?.error_code || 'INTERNAL_ERROR',
+            stage: task?.error_stage || 'unknown',
+            error: task?.error || 'A execução não pôde ser concluída.'
+          };
+        }
+
+        if (status === 'awaiting_approval') {
+          return {
+            ok: true,
+            requires_approval: true,
+            task_id: taskId,
+            repository: result?.repository || currentRepository || '',
+            branch: task?.branch_name || '',
+            summary: task?.summary || '',
+            assistant_message: task?.summary || 'Alteração preparada e aguardando aprovação.',
+            pull_request_url: task?.pull_request_url || ''
+          };
+        }
+
+        if (status === 'awaiting_input') {
+          return {
+            ok: true,
+            requires_input: true,
+            task_id: taskId,
+            summary: task?.summary || '',
+            assistant_message: task?.summary || 'Preciso de uma informação para continuar.'
+          };
+        }
+
+        if (status === 'cancelled') {
+          return { ok: false, code: 'TASK_CANCELLED', stage: 'finalizing', error: 'A tarefa foi cancelada.' };
+        }
+      }
+
+      // TASK_NOT_FOUND logo após timeout pode significar que a primeira resposta se perdeu
+      // antes da leitura do registro. Dê uma janela curta para o backend aparecer.
+      await new Promise(resolve => setTimeout(resolve, attempt < 6 ? 700 : 1200));
+    }
+    return null;
+  };
