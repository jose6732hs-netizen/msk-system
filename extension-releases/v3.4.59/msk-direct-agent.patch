+  const formatAgentFailure = (source = {}, fallback = 'A execução não pôde ser concluída.') => {
+    const message = String(source?.error || source?.message || fallback).trim() || fallback;
+    const code = String(source?.error_code || source?.code || 'INTERNAL_ERROR').trim().toUpperCase();
+    const stage = String(source?.error_stage || source?.stage || '').trim().toLowerCase();
+    const errorId = String(source?.last_error_id || source?.error_id || '').trim();
+    const retryCount = Number(source?.retry_count);
+    const lines = [`❌ ${message}`, `Código: ${code}`];
+    if (stage) lines.push(`Etapa: ${stage}`);
+    if (Number.isFinite(retryCount) && retryCount > 0) lines.push(`Tentativas automáticas: ${retryCount + 1}`);
+    if (errorId) lines.push(`ID de diagnóstico: ${errorId}`);
+    if (source?.retryable === true) lines.push('A falha é temporária e pode ser tentada novamente com segurança.');
+    return lines.join('\n');
+  };
