{
  "manifest_version": 3,
  "name": "MSK System Studio",
  "version": "3.4.9",
  "description": "MSK System Studio — backend MSK, seletor de IA/modelos liberados, GitHub OAuth/App e recuperação de execuções longas.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://msksystem.online/*",
    "https://msk-system.lovable.app/*",
    "https://iybjfmhqbblrppqoodyf.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "MSK System",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "3.4.9 PROTECTED · IA/Modelos do Admin · GitHub OAuth · Long Run Recovery"
}
