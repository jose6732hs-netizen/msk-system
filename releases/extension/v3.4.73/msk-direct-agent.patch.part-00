-      const firstInput = root.querySelector('.msk-input')?.closest('form, .msk-input-wrap, .msk-compose, .msk-footer');
-      if (firstInput?.parentElement === root) root.insertBefore(thread, firstInput);
-      else root.appendChild(thread);
     }
+    // O histórico MSK fica SEMPRE imediatamente acima do composer. Assim a
+    // mensagem mais recente nunca aparece perdida no topo do painel.
+    if (composer?.parentElement === root) {
+      if (thread.parentElement !== root || thread.nextElementSibling !== composer) root.insertBefore(thread, composer);
+    } else if (thread.parentElement !== root) root.appendChild(thread);
     return thread;
   };
 
+  const refreshLovablePreview = async () => {
+    const candidates = [...document.querySelectorAll('button,[role="button"]')].filter(button => {
+      if (button.closest('#msk-root')) return false;
+      const text = `${button.textContent || ''} ${button.getAttribute('aria-label') || ''} ${button.getAttribute('title') || ''}`.replace(/\s+/g, ' ').trim();
+      return /(refresh|reload|recarregar|atualizar).{0,35}(preview|pr[eé]via)|(preview|pr[eé]via).{0,35}(refresh|reload|recarregar|atualizar)/i.test(text);
+    });
+    if (candidates[0]) { candidates[0].click(); return { ok: true, method: 'lovable-button' }; }
+    const frame = [...document.querySelectorAll('iframe')].find(node => {
+      if (node.closest('#msk-root')) return false;
+      const rect = node.getBoundingClientRect();
+      return rect.width > 180 && rect.height > 120 && !!String(node.src || '').trim();
+    });
+    if (frame) {
+      const src = frame.src;
+      frame.src = 'about:blank';
+      await new Promise(resolve => setTimeout(resolve, 80));
+      frame.src = src;
+      return { ok: true, method: 'iframe-reload' };
+    }
+    return { ok: false, error: 'Não encontrei o preview aberto nesta tela do Lovable.' };
+  };
