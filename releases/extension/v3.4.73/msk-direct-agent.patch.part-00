   const ensureThread = () => {
     const root = chatRoot();
     if (!root) return null;
+    const composer = root.querySelector('.msk-input')?.closest('form, .msk-input-wrap, .msk-compose, .msk-footer')
+      || root.querySelector(':scope > .msk-footer, :scope > form, :scope > .msk-compose');
     let thread = root.querySelector(':scope > .msk-direct-thread');
     if (!thread) {
       thread = document.createElement('section');
