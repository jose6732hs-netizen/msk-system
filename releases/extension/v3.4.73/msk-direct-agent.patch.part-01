+  const databaseStatusText = connection => {
+    const status = String(connection?.status || 'unknown');
+    if (status === 'connected') return 'Conectado';
+    if (status === 'linked') return 'Vinculado';
+    if (status === 'degraded') return 'Atenção';
+    if (status === 'error') return 'Erro';
+    return 'Não verificado';
+  };
+
+  const openDatabaseManager = async () => {
+    const projectId = await projectIdFromPage();
+    const thread = ensureThread();
+    if (!projectId || !thread) return addMessage('Não consegui identificar o projeto Lovable atual para conectar o banco.', 'error');
+    thread.querySelector('.msk-direct-db-manager')?.remove();
+    const row = document.createElement('div');
+    row.className = 'msk-direct-message msk-direct-assistant msk-direct-compact-card msk-direct-db-manager';
+    const head = document.createElement('div'); head.className = 'msk-direct-message-head';
+    const title = document.createElement('strong'); title.textContent = 'MSK · CONEXÕES DE BANCO';
+    const pill = document.createElement('span'); pill.className = 'msk-direct-ai-badge'; pill.textContent = 'SEGURO';
+    head.append(title, pill);
+    const intro = document.createElement('div'); intro.className = 'msk-direct-card-preview';
+    intro.textContent = 'Conecte Supabase ou vincule Lovable Cloud ao projeto atual. Credenciais são criptografadas no backend e nunca voltam para o navegador.';
+    const list = document.createElement('div'); list.className = 'msk-direct-db-list';
+    const form = document.createElement('div'); form.className = 'msk-direct-db-form';
+    row.append(head, intro, list, form); thread.appendChild(row); rootScroll(thread);
+
+    const load = async () => {
+      list.textContent = 'Verificando conexões…';
+      const response = await send({ type: 'MSK_DATABASE_CONNECTION_LIST_V1', payload: { lovable_project_id: projectId } }).catch(() => null);
+      const connections = Array.isArray(response?.connections) ? response.connections : [];
+      list.textContent = '';
+      if (!connections.length) {
+        const empty = document.createElement('div'); empty.className = 'msk-direct-db-empty'; empty.textContent = 'Nenhuma conexão salva para este projeto.'; list.appendChild(empty);
+      }
+      for (const connection of connections) {
+        const item = document.createElement('div'); item.className = 'msk-direct-db-item';
+        const main = document.createElement('div'); main.className = 'msk-direct-db-item-main';
+        const label = document.createElement('strong'); label.textContent = `${connection.provider === 'supabase' ? 'Supabase' : 'Lovable Cloud'} · ${connection.name || 'Produção'}`;
+        const meta = document.createElement('span'); meta.textContent = `${databaseStatusText(connection)}${Number.isFinite(Number(connection.latency_ms)) ? ` · ${connection.latency_ms}ms` : ''}${connection.is_default ? ' · padrão' : ''}`;
+        main.append(label, meta);
+        const actions = document.createElement('div'); actions.className = 'msk-direct-db-item-actions';
+        const test = document.createElement('button'); test.type='button'; test.textContent='Testar';
+        test.onclick = async () => { test.disabled=true; test.textContent='Testando…'; const result=await send({type:'MSK_DATABASE_CONNECTION_TEST_V1',payload:{lovable_project_id:projectId,connection_id:connection.id}}).catch(()=>null); test.disabled=false; test.textContent=result?.ok?'✓ OK':'⚠ Falhou'; setTimeout(load,700); };
+        actions.appendChild(test);
+        if (!connection.is_default) { const def=document.createElement('button'); def.type='button'; def.textContent='Padrão'; def.onclick=async()=>{def.disabled=true;await send({type:'MSK_DATABASE_CONNECTION_DEFAULT_V1',payload:{lovable_project_id:projectId,connection_id:connection.id}}).catch(()=>null);await load();await refreshDatabaseButtonStatus();}; actions.appendChild(def); }
