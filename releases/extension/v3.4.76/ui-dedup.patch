+  const compactText = value => String(value || "").replace(/\s+/g, " ").trim();
+
+  // v3.4.76 — uma única fonte visual para projeto/status/controles.
+  const normalizeDuplicateProjectUi = () => {
+    const root = getRoot();
+    if (!root) return;
+
+    const statusList = root.querySelector('.msk-auto-steps');
+    if (statusList) {
+      const statusItems = [...statusList.querySelectorAll('li')];
+      const isConnectionOnly = statusList.dataset.statusOnly === 'true' ||
+        (statusItems.length > 0 && statusItems.every(item => ['project', 'github', 'repository'].includes(String(item.dataset.mskStatusKey || ''))));
+      if (isConnectionOnly) {
+        if (statusList.dataset.mskUiDedupHidden !== '1') statusList.dataset.mskUiDedupHidden = '1';
+        if (statusList.getAttribute('aria-hidden') !== 'true') statusList.setAttribute('aria-hidden', 'true');
+        if (statusList.style.getPropertyValue('display') !== 'none' || statusList.style.getPropertyPriority('display') !== 'important') {
+          statusList.style.setProperty('display', 'none', 'important');
+        }
+      }
+    }
+
+    const allClickable = [...root.querySelectorAll('button, a, [role="button"]')];
+    const zipCandidates = allClickable.filter(el => /^(?:⬇\s*)?baixar projeto\s*\(zip\)$/i.test(compactText(el.textContent)));
+    if (zipCandidates.length > 1) {
+      const preferred = zipCandidates.find(el => el.classList?.contains('msk-download-project')) || zipCandidates[0];
+      for (const el of zipCandidates) {
+        if (el === preferred) continue;
+        if (el.dataset.mskUiDuplicate !== 'zip') el.dataset.mskUiDuplicate = 'zip';
+        if (el.getAttribute('aria-hidden') !== 'true') el.setAttribute('aria-hidden', 'true');
+        if (el.style.getPropertyValue('display') !== 'none' || el.style.getPropertyPriority('display') !== 'important') {
+          el.style.setProperty('display', 'none', 'important');
+        }
+        if ('disabled' in el && !el.disabled) el.disabled = true;
+      }
+    }
+
+    const hasProjectIdCard = !!root.querySelector('[class*="project"]') && /ID DO PROJETO/i.test(compactText(root.textContent));
+    if (hasProjectIdCard) {
+      const leaves = [...root.querySelectorAll('div, p, span, li')].filter(el => el.children.length <= 2);
+      for (const el of leaves) {
+        if (el.closest('.msk-direct-thread')) continue;
+        const text = compactText(el.textContent);
+        const isLovableSummary = /^Lovable:\s*[0-9a-f-]{12,}$/i.test(text);
+        const isGithubSummary = /^GitHub:\s*conectado\s*-/i.test(text);
+        if (!isLovableSummary && !isGithubSummary) continue;
+        if (isLovableSummary) {
+          if (el.dataset.mskUiDuplicate !== 'lovable') el.dataset.mskUiDuplicate = 'lovable';
+          if (el.style.getPropertyValue('display') !== 'none' || el.style.getPropertyPriority('display') !== 'important') {
+            el.style.setProperty('display', 'none', 'important');
+          }
+          continue;
+        }
+        const same = leaves.filter(node => /^GitHub:\s*conectado/i.test(compactText(node.textContent)));
+        if (same.indexOf(el) > 0) {
+          if (el.dataset.mskUiDuplicate !== 'github') el.dataset.mskUiDuplicate = 'github';
+          if (el.style.getPropertyValue('display') !== 'none' || el.style.getPropertyPriority('display') !== 'important') {
+            el.style.setProperty('display', 'none', 'important');
+          }
+        }
+      }
+    }
+  };
@@
