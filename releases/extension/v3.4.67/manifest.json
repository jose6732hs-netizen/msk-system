{
  "manifest_version": 3,
  "name": "MSK Agente — Guardião Lovable",
  "version": "3.4.67",
  "description": "MSK Agente com pre-flight schema-only sem INSERT de teste, comando exato, GitHub App write validado e persistência real tratada pelo executor.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "windows",
    "unlimitedStorage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://msksystem.online/*",
    "https://api.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://github.com/*",
    "https://iybjfmhqbblrppqoodyf.supabase.co/*"
  ],
  "background": {
    "service_worker": "background-wrapper.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["msk-lovable-session.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["msk-lovable-cards.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://lovable.dev/*"],
      "js": [
        "msk-license.js",
        "msk-license-fast.js",
        "msk-license-resilient.js",
        "config.js",
        "content.js",
        "msk-phone-notch.js",
        "jszip.min.js",
        "msk-enhancements.js",
        "msk-ui-fixes.js",
        "msk-custom-skills.js",
        "msk-active-skill.js",
        "msk-multimodal.js",
        "msk-preflight.js",
        "msk-direct-agent.js",
        "msk-github-ui-bridge.js",
        "msk-internal-mode-compat.js",
        "msk-license-github-unlock.js"
      ],
      "css": [
        "content.css",
        "msk-enhancements.css",
        "msk-ui-fixes.css",
        "msk-custom-skills.css",
        "msk-active-skill.css",
        "msk-multimodal.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/settings/installations",
        "https://github.com/settings/installations/*"
      ],
      "js": ["msk-github-installation-watch.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://lovable.dev/*"]
    }
  ],
  "action": {
    "default_title": "Ativar Guardião MSK",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "options.html"
}
