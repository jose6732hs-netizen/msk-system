{
  "manifest_version": 3,
  "name": "Infinity Credits",
  "version": "3.0.0",
  "description": "Loader seguro e dinâmico.",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "storage",
    "sidePanel",
    "alarms",
    "notifications",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://msk-keymaster.lovable.app/*",
    "https://supabase.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir Painel Lateral",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
