{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zjrrymncmiyftyogejjr.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "msk-sistem",
      "version": "1.0.0",
      "title": "MSK SISTEM"
    },
    "tools": [
      {
        "name": "get_my_account",
        "title": "Get my account",
        "description": "Return the signed-in user's profile (name, email, phone) and assigned roles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "string"
            },
            "email": {
              "type": [
                "string",
                "null"
              ]
            },
            "profile": {
              "anyOf": [
                {},
                {
                  "type": "null"
                }
              ]
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "userId",
            "email",
            "roles"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      },
      {
        "name": "list_my_licenses",
        "title": "List my licenses",
        "description": "List the signed-in user's extension licenses with status, type, activation and expiry dates. Never returns the license secret, only the last 4 characters.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Optional status filter, e.g. active, expired, revoked."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of licenses to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "licenses": {
              "type": "array"
            }
          },
          "required": [
            "licenses"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      },
      {
        "name": "get_my_token_balance",
        "title": "Get my token balance",
        "description": "Return the signed-in user's token allowances (total, used, remaining, period end) and any active trial.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "remaining": {
              "type": "number"
            },
            "totalGranted": {
              "type": "number"
            },
            "totalUsed": {
              "type": "number"
            },
            "allowances": {
              "type": "array"
            },
            "trials": {
              "type": "array"
            }
          },
          "required": [
            "remaining",
            "totalGranted",
            "totalUsed",
            "allowances",
            "trials"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      },
      {
        "name": "list_plans",
        "title": "List plans",
        "description": "List the active plans sold by this app, with price, duration, device limits and highlights.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "plans": {
              "type": "array"
            }
          },
          "required": [
            "plans"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      }
    ]
  }
}
